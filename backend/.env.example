# PostgreSQL — matches docker-compose.yml defaults
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/taggit

# Supabase Auth (identity only) — see docs/auth-setup.md
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Cloudflare R2 image storage — see docs/r2-setup.md
# For local dev, point at the MinIO service in docker-compose.yml instead of
# real R2 (docker compose up -d minio minio-init):
#   R2_ENDPOINT_URL=http://localhost:9000
#   R2_ACCOUNT_ID=local
#   R2_ACCESS_KEY_ID=minioadmin
#   R2_SECRET_ACCESS_KEY=minioadmin
#   R2_BUCKET=taggit-images
#   R2_PUBLIC_BASE_URL=http://localhost:9000/taggit-images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT_URL=
