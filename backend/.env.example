# PostgreSQL — matches docker-compose.yml defaults
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/taggit

# Supabase Auth (identity only) — see docs/auth-setup.md
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Cloudflare R2 image storage — see docs/r2-setup.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
